page {
  --color-page: #f7f8fc;
  --color-surface: #fffefa;
  --color-heading: #262350;
  --color-heading-rgb: 38, 35, 80;
  --color-text: #475569;
  --color-text-strong: #334155;
  --color-muted: #64748b;
  --color-accent: #6754a4;
  --color-accent-rgb: 103, 84, 164;
  --color-accent-strong: #514084;
  --color-accent-soft: #f0eef8;
  --color-accent-tint: #e8e2f3;
  --color-accent-border: #d8cee9;
  --color-border: #e9e4db;
  --color-divider: #e8ebf2;
  --color-disabled: #e7e5ee;
  --color-disabled-text: #676479;
  --color-white: #ffffff;
  --color-on-dark: #e0e7ff;
  --color-on-dark-muted: #c7d2fe;
  --color-success: #21684f;
  --color-success-soft: #eaf6ef;
  --color-success-indicator: #16a34a;
  --color-warning: #9a3412;
  --color-warning-soft: #fff7ed;
  --color-warning-border: #fed7aa;
  --color-danger: #be123c;
  --color-danger-soft: #fff1f2;
  min-height: 100%;
  background: var(--color-page);
  color: var(--color-text);
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", "PingFang SC", "Hiragino Sans GB", "Microsoft YaHei", sans-serif;
  font-size: 30rpx;
}

button {
  font-family: inherit;
}

.page-shell {
  box-sizing: border-box;
  min-height: 100vh;
  padding: 32rpx;
}

.card {
  box-sizing: border-box;
  background: var(--color-surface);
  border: 1rpx solid var(--color-border);
  border-radius: 28rpx;
  box-shadow: 0 12rpx 36rpx rgba(var(--color-heading-rgb), 0.06);
}

.button-primary,
.button-secondary,
.button-danger,
.button-ghost {
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  min-height: 96rpx;
  margin: 0;
  border-radius: 20rpx;
  font-size: 32rpx;
  font-weight: 600;
  line-height: 1.2;
}

.button-primary::after,
.button-secondary::after,
.button-danger::after,
.button-ghost::after {
  border: none;
}

.button-primary {
  background: var(--color-accent);
  color: var(--color-white);
}

.button-primary[disabled] {
  background: var(--color-disabled);
  color: var(--color-disabled-text);
}

.button-secondary {
  background: var(--color-accent-soft);
  color: var(--color-accent-strong);
}

.button-danger {
  background: var(--color-danger-soft);
  color: var(--color-danger);
}

.button-ghost {
  background: var(--color-surface);
  border: 1rpx solid var(--color-border);
  color: var(--color-text);
}

.section-title {
  color: var(--color-heading);
  font-size: 36rpx;
  font-weight: 700;
}

.muted {
  color: var(--color-muted);
}

.case-avatar {
  box-sizing: border-box;
  flex: 0 0 96rpx;
  width: 96rpx;
  height: 96rpx;
  border: 2rpx solid var(--color-accent-border);
  border-radius: 50%;
  background: var(--color-accent-soft);
}

.empty-state {
  padding: 100rpx 36rpx;
  text-align: center;
}

.safe-bottom {
  padding-bottom: calc(32rpx + env(safe-area-inset-bottom));
}
