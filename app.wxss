page {
  min-height: 100%;
  background: #f7f8fc;
  color: #1f2937;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", "PingFang SC", "Hiragino Sans GB", "Microsoft YaHei", sans-serif;
  font-size: 30rpx;
}

.page-shell {
  box-sizing: border-box;
  min-height: 100vh;
  padding: 32rpx;
}

.card {
  box-sizing: border-box;
  background: #ffffff;
  border: 1rpx solid #e8ebf2;
  border-radius: 28rpx;
  box-shadow: 0 12rpx 36rpx rgba(30, 41, 59, 0.06);
}

.button-primary,
.button-secondary,
.button-danger,
.button-ghost {
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  min-height: 96rpx;
  margin: 0;
  border-radius: 20rpx;
  font-size: 32rpx;
  font-weight: 600;
  line-height: 1.2;
}

.button-primary::after,
.button-secondary::after,
.button-danger::after,
.button-ghost::after {
  border: none;
}

.button-primary {
  background: #4f46e5;
  color: #ffffff;
}

.button-primary[disabled] {
  background: #c7c9d9;
  color: #ffffff;
}

.button-secondary {
  background: #eef2ff;
  color: #4338ca;
}

.button-danger {
  background: #fff1f2;
  color: #be123c;
}

.button-ghost {
  background: #ffffff;
  border: 1rpx solid #dfe3eb;
  color: #475569;
}

.section-title {
  color: #111827;
  font-size: 36rpx;
  font-weight: 700;
}

.muted {
  color: #64748b;
}

.case-avatar {
  box-sizing: border-box;
  flex: 0 0 96rpx;
  width: 96rpx;
  height: 96rpx;
  border: 2rpx solid #d7c69d;
  border-radius: 50%;
  background: #f1eadb;
}

.empty-state {
  padding: 100rpx 36rpx;
  text-align: center;
}

.safe-bottom {
  padding-bottom: calc(32rpx + env(safe-area-inset-bottom));
}
