@import "../../components/type-representatives/type-representatives.wxss";
@import "../../components/professional-profile/professional-profile.wxss";

.report-page {
  padding-left: 28rpx;
  padding-right: 28rpx;
}

.checkout-title {
  margin: 10rpx 0 12rpx;
  font-size: 54rpx;
  font-weight: 800;
  line-height: 1.2;
}

.checkout-feature {
  margin-top: 20rpx;
  padding-top: 18rpx;
  border-top: 1rpx solid var(--color-divider);
}

.checkout-price-row {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 16rpx;
  margin-top: 22rpx;
  color: var(--color-text);
  font-size: 26rpx;
}

.checkout-price {
  color: var(--color-heading);
  font-size: 42rpx;
  font-weight: 800;
  font-variant-numeric: tabular-nums;
}

.checkout-reference {
  display: flex;
  align-items: center;
  gap: 14rpx;
  margin-top: 20rpx;
  color: var(--color-muted);
  font-size: 24rpx;
}

.checkout-reference-copy {
  flex: 1;
  min-width: 0;
}

.checkout-reference-number {
  margin-top: 4rpx;
  word-break: break-all;
  color: var(--color-text);
  font-variant-numeric: tabular-nums;
}

.checkout-copy-button {
  flex: none;
  min-height: 58rpx;
  padding: 0 16rpx;
  font-size: 24rpx;
}

.report-hero {
  padding: 36rpx 32rpx;
  border-radius: 28rpx;
  background: var(--color-heading);
  color: var(--color-white);
}

.report-kicker,
.report-date {
  color: var(--color-on-dark-muted);
  font-size: 25rpx;
}

.report-hero-main {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 16rpx 30rpx;
  margin: 16rpx 0 22rpx;
}

.report-code {
  font-size: 82rpx;
  font-weight: 700;
  line-height: 1.05;
  letter-spacing: 4rpx;
}

.report-objective {
  flex: 1 1 220rpx;
  color: var(--color-on-dark);
  font-size: 29rpx;
  line-height: 1.5;
}

.report-section {
  margin-top: 22rpx;
  padding: 28rpx;
}

.report-save-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
  margin-top: 18rpx;
}

.report-save-actions button {
  flex: 1 1 260rpx;
  padding: 0 16rpx;
  font-size: 27rpx;
}

.report-copy,
.report-practice,
.report-note,
.report-footer {
  margin-top: 10rpx;
  color: var(--color-text);
  font-size: 27rpx;
  line-height: 1.6;
}

.report-chart {
  margin-top: 22rpx;
}

.report-note {
  padding: 14rpx 18rpx;
  border-radius: 12rpx;
  background: var(--color-accent-soft);
  color: var(--color-accent-strong);
}

.report-activity,
.report-link {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 16rpx;
  padding: 18rpx 0;
  border-bottom: 1rpx solid var(--color-divider);
  font-size: 26rpx;
}

.report-activity:last-child,
.report-link:last-child {
  padding-bottom: 0;
  border-bottom: 0;
}

.report-activity-label {
  flex: 0 0 158rpx;
  color: var(--color-accent-strong);
  font-weight: 600;
}

.report-link-body {
  flex: 1;
  min-width: 0;
}

.report-item-title {
  color: var(--color-heading);
  font-size: 30rpx;
  font-weight: 700;
  line-height: 1.45;
}

.report-practice {
  color: var(--color-accent-strong);
}

.report-arrow {
  color: var(--color-muted);
  font-size: 44rpx;
  line-height: 1;
}

.report-horizons {
  display: flex;
  gap: 12rpx;
  margin-top: 18rpx;
}

.report-horizon {
  flex: 1;
  margin: 0;
  padding: 18rpx 10rpx;
  border-radius: 14rpx;
  background: var(--color-accent-soft);
  color: var(--color-accent-strong);
  font-size: 28rpx;
  font-weight: 600;
  line-height: 1.5;
}

.report-horizon::after {
  border: none;
}

.report-horizon-active {
  background: var(--color-accent-strong);
  color: var(--color-white);
}

.report-timeline {
  margin: 26rpx 0 0 8rpx;
}

.report-milestone {
  position: relative;
  padding: 0 0 26rpx 24rpx;
  border-left: 2rpx solid var(--color-accent-border);
}

.report-milestone:last-child {
  padding-bottom: 0;
}

.report-milestone::before {
  position: absolute;
  top: 10rpx;
  left: -8rpx;
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: var(--color-accent);
  content: '';
}

.report-period {
  margin-bottom: 4rpx;
  color: var(--color-accent-strong);
  font-size: 25rpx;
  font-weight: 600;
}

.report-output {
  margin-top: 12rpx;
  color: var(--color-text-strong);
  font-size: 26rpx;
  line-height: 1.55;
}

.report-output text {
  color: var(--color-accent-strong);
  font-weight: 600;
}

.report-footer {
  margin: 24rpx 8rpx 0;
}

.report-return {
  margin-top: 24rpx;
}
