@import "../../components/type-representatives/type-representatives.wxss";

.report-page {
  padding-left: 28rpx;
  padding-right: 28rpx;
}

.report-hero {
  padding: 36rpx 32rpx;
  border-radius: 28rpx;
  background: #262350;
  color: #ffffff;
}

.report-kicker,
.report-date {
  color: #c7d2fe;
  font-size: 25rpx;
}

.report-hero-main {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 16rpx 30rpx;
  margin: 16rpx 0 22rpx;
}

.report-code {
  font-size: 82rpx;
  font-weight: 700;
  line-height: 1.05;
  letter-spacing: 4rpx;
}

.report-objective {
  flex: 1 1 220rpx;
  color: #e0e7ff;
  font-size: 29rpx;
  line-height: 1.5;
}

.report-section {
  margin-top: 22rpx;
  padding: 28rpx;
}

.report-save-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
  margin-top: 18rpx;
}

.report-save-actions button {
  flex: 1 1 260rpx;
  padding: 0 16rpx;
  font-size: 27rpx;
}

.report-copy,
.report-practice,
.report-note,
.report-footer {
  margin-top: 10rpx;
  color: #475569;
  font-size: 27rpx;
  line-height: 1.6;
}

.report-chart {
  margin-top: 22rpx;
}

.report-note {
  padding: 14rpx 18rpx;
  border-radius: 12rpx;
  background: #eef2ff;
  color: #37308c;
}

.report-activity,
.report-link {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 16rpx;
  padding: 18rpx 0;
  border-bottom: 1rpx solid #e8ebf2;
  font-size: 26rpx;
}

.report-activity:last-child,
.report-link:last-child {
  padding-bottom: 0;
  border-bottom: 0;
}

.report-activity-label {
  flex: 0 0 158rpx;
  color: #4338ca;
  font-weight: 600;
}

.report-link-body {
  flex: 1;
  min-width: 0;
}

.report-item-title {
  color: #1e293b;
  font-size: 30rpx;
  font-weight: 700;
  line-height: 1.45;
}

.report-practice {
  color: #37308c;
}

.report-arrow {
  color: #64748b;
  font-size: 44rpx;
  line-height: 1;
}

.report-horizons {
  display: flex;
  gap: 12rpx;
  margin-top: 18rpx;
}

.report-horizon {
  flex: 1;
  margin: 0;
  padding: 18rpx 10rpx;
  border-radius: 14rpx;
  background: #eef2ff;
  color: #4338ca;
  font-size: 28rpx;
  font-weight: 600;
  line-height: 1.5;
}

.report-horizon::after {
  border: none;
}

.report-horizon-active {
  background: #4338ca;
  color: #ffffff;
}

.report-timeline {
  margin: 26rpx 0 0 8rpx;
}

.report-milestone {
  position: relative;
  padding: 0 0 26rpx 24rpx;
  border-left: 2rpx solid #c7d2fe;
}

.report-milestone:last-child {
  padding-bottom: 0;
}

.report-milestone::before {
  position: absolute;
  top: 10rpx;
  left: -8rpx;
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: #4f46e5;
  content: '';
}

.report-period {
  margin-bottom: 4rpx;
  color: #4338ca;
  font-size: 25rpx;
  font-weight: 600;
}

.report-output {
  margin-top: 12rpx;
  color: #334155;
  font-size: 26rpx;
  line-height: 1.55;
}

.report-output text {
  color: #4338ca;
  font-weight: 600;
}

.report-footer {
  margin: 24rpx 8rpx 0;
}

.report-return {
  margin-top: 24rpx;
}
