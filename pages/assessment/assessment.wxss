.assessment-page {
  padding-top: 28rpx;
}

.assessment-meta {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 18rpx;
}

.assessment-context {
  display: inline-flex;
  padding: 8rpx 14rpx;
  border: 1rpx solid var(--color-accent-border);
  border-radius: 999rpx;
  background: var(--color-accent-soft);
  color: var(--color-accent-strong);
  font-size: 21rpx;
  font-weight: 700;
}

.autosave-indicator {
  display: flex;
  align-items: center;
  color: var(--color-muted);
  font-size: 20rpx;
}

.autosave-dot {
  width: 12rpx;
  height: 12rpx;
  margin-right: 8rpx;
  border-radius: 50%;
  background: var(--color-success-indicator);
  box-shadow: 0 0 0 6rpx rgba(22, 163, 74, 0.1);
}

.progress-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 4rpx;
}

.progress-count {
  color: var(--color-accent-strong);
  font-size: 30rpx;
  font-weight: 700;
}

.answered-count {
  color: var(--color-muted);
  font-size: 24rpx;
}

.progress-track {
  overflow: hidden;
  height: 12rpx;
  margin-top: 20rpx;
  border-radius: 999rpx;
  background: var(--color-divider);
}

.progress-fill {
  height: 100%;
  border-radius: 999rpx;
  background: var(--color-accent);
  transition: width 0.2s ease;
}

.progress-tip {
  margin: 14rpx 4rpx 0;
  color: var(--color-muted);
  font-size: 20rpx;
  line-height: 1.5;
}

.question-card {
  margin-top: 32rpx;
  padding: 36rpx 32rpx 34rpx;
}

.question-section {
  margin-bottom: 8rpx;
  color: var(--color-accent-strong);
  font-size: 24rpx;
  font-weight: 700;
}

.question-section + .question-kicker {
  padding-bottom: 18rpx;
}

.question-kicker {
  padding-bottom: 28rpx;
  border-bottom: 1rpx solid var(--color-divider);
  color: var(--color-muted);
  font-size: 23rpx;
  line-height: 1.6;
}

.question-prefix {
  margin-top: 34rpx;
  color: var(--color-accent);
  font-size: 26rpx;
  font-weight: 600;
}

.question-text {
  min-height: 128rpx;
  margin-top: 14rpx;
  color: var(--color-heading);
  font-size: 40rpx;
  font-weight: 700;
  line-height: 1.55;
}

.option-list {
  margin-top: 22rpx;
}

.option-item {
  display: flex;
  align-items: center;
  min-height: 86rpx;
  margin-top: 16rpx;
  padding: 0 24rpx;
  border: 2rpx solid var(--color-divider);
  border-radius: 18rpx;
  background: var(--color-surface);
}

.option-selected {
  border-color: var(--color-accent);
  background: var(--color-accent-soft);
}

.option-radio {
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  width: 34rpx;
  height: 34rpx;
  margin-right: 22rpx;
  border: 2rpx solid var(--color-accent-border);
  border-radius: 50%;
}

.option-selected .option-radio {
  border-color: var(--color-accent);
}

.option-radio-dot {
  width: 18rpx;
  height: 18rpx;
  border-radius: 50%;
  background: var(--color-accent);
}

.option-label {
  flex: 1;
  color: var(--color-text-strong);
  font-size: 29rpx;
}

.option-value {
  color: var(--color-muted);
  font-size: 24rpx;
}

.option-selected .option-label,
.option-selected .option-value {
  color: var(--color-accent-strong);
  font-weight: 600;
}

.navigation-row {
  display: flex;
  gap: 20rpx;
  margin-top: 30rpx;
}

.previous-button {
  width: 200rpx;
}

.previous-button[disabled] {
  background: var(--color-accent-soft);
  color: var(--color-muted);
}

.next-button {
  flex: 1;
}
