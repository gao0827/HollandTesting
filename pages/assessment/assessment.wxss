.assessment-page {
  padding-top: 28rpx;
}

.assessment-meta {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 18rpx;
}

.assessment-context {
  display: inline-flex;
  padding: 8rpx 14rpx;
  border: 1rpx solid #e2d3bb;
  border-radius: 999rpx;
  background: #fff8ea;
  color: #8f5d32;
  font-size: 21rpx;
  font-weight: 700;
}

.autosave-indicator {
  display: flex;
  align-items: center;
  color: #64748b;
  font-size: 20rpx;
}

.autosave-dot {
  width: 12rpx;
  height: 12rpx;
  margin-right: 8rpx;
  border-radius: 50%;
  background: #16a34a;
  box-shadow: 0 0 0 6rpx rgba(22, 163, 74, 0.1);
}

.progress-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 4rpx;
}

.progress-count {
  color: #3730a3;
  font-size: 30rpx;
  font-weight: 700;
}

.answered-count {
  color: #94a3b8;
  font-size: 24rpx;
}

.progress-track {
  overflow: hidden;
  height: 12rpx;
  margin-top: 20rpx;
  border-radius: 999rpx;
  background: #e5e7eb;
}

.progress-fill {
  height: 100%;
  border-radius: 999rpx;
  background: linear-gradient(90deg, #6366f1, #8b5cf6);
  transition: width 0.2s ease;
}

.progress-tip {
  margin: 14rpx 4rpx 0;
  color: #94a3b8;
  font-size: 20rpx;
  line-height: 1.5;
}

.question-card {
  margin-top: 32rpx;
  padding: 36rpx 32rpx 34rpx;
}

.question-kicker {
  padding-bottom: 28rpx;
  border-bottom: 1rpx solid #eef0f4;
  color: #94a3b8;
  font-size: 23rpx;
  line-height: 1.6;
}

.question-prefix {
  margin-top: 34rpx;
  color: #6366f1;
  font-size: 26rpx;
  font-weight: 600;
}

.question-text {
  min-height: 128rpx;
  margin-top: 14rpx;
  color: #111827;
  font-size: 40rpx;
  font-weight: 700;
  line-height: 1.55;
}

.option-list {
  margin-top: 22rpx;
}

.option-item {
  display: flex;
  align-items: center;
  min-height: 86rpx;
  margin-top: 16rpx;
  padding: 0 24rpx;
  border: 2rpx solid #e5e7eb;
  border-radius: 18rpx;
  background: #ffffff;
}

.option-selected {
  border-color: #6366f1;
  background: #eef2ff;
}

.option-radio {
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  width: 34rpx;
  height: 34rpx;
  margin-right: 22rpx;
  border: 2rpx solid #cbd5e1;
  border-radius: 50%;
}

.option-selected .option-radio {
  border-color: #6366f1;
}

.option-radio-dot {
  width: 18rpx;
  height: 18rpx;
  border-radius: 50%;
  background: #6366f1;
}

.option-label {
  flex: 1;
  color: #334155;
  font-size: 29rpx;
}

.option-value {
  color: #cbd5e1;
  font-size: 24rpx;
}

.option-selected .option-label,
.option-selected .option-value {
  color: #4338ca;
  font-weight: 600;
}

.navigation-row {
  display: flex;
  gap: 20rpx;
  margin-top: 30rpx;
}

.previous-button {
  width: 200rpx;
}

.previous-button[disabled] {
  background: #f8fafc;
  color: #cbd5e1;
}

.next-button {
  flex: 1;
}
