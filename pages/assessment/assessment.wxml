<view class="page-shell assessment-page safe-bottom">
  <view class="assessment-meta">
    <view class="assessment-context">{{userTypeLabel}} · {{assessmentTypeLabel}} {{total}} 题</view>
    <view class="autosave-indicator"><text wx:if="{{!draftSaveFailed}}" class="autosave-dot"></text>{{draftSaveFailed ? '暂未保存' : '自动保存'}}</view>
  </view>
  <view class="progress-head">
    <text class="progress-count">{{currentNumber}} / {{total}}</text>
    <text class="answered-count">已答 {{answeredCount}} 题</text>
  </view>
  <view class="progress-track">
    <view class="progress-fill" style="width: {{progress}}%;"></view>
  </view>
  <view class="progress-tip">可随时返回上一题修改答案，退出后将从当前题目继续。</view>

  <view class="question-card card" wx:if="{{currentQuestion}}">
    <view wx:if="{{sectionLabel}}" class="question-section">{{sectionLabel}} · 单选</view>
    <view class="question-kicker">{{questionPrompt}}</view>
    <view wx:if="{{questionPrefix}}" class="question-prefix">{{questionPrefix}}</view>
    <view class="question-text">{{currentQuestion.text}}</view>

    <view class="option-list">
      <view
        wx:for="{{responseOptions}}"
        wx:key="value"
        class="option-item {{item.selected ? 'option-selected' : ''}}"
        data-value="{{item.value}}"
        bindtap="selectAnswer"
      >
        <view class="option-radio">
          <view wx:if="{{item.selected}}" class="option-radio-dot"></view>
        </view>
        <text class="option-label">{{item.label}}</text>
        <text wx:if="{{item.value <= 5}}" class="option-value">{{item.value}}</text>
      </view>
    </view>
  </view>

  <view class="navigation-row">
    <button
      class="button-ghost previous-button"
      disabled="{{!canGoBack}}"
      bindtap="goPrevious"
    >上一题</button>
    <button
      class="button-primary next-button"
      disabled="{{!currentAnswer}}"
      bindtap="goNext"
    >{{isLast ? '生成结果' : '下一题'}}</button>
  </view>
</view>
