.detail-page {
  padding-top: 30rpx;
}

.detail-hero {
  padding: 42rpx 32rpx;
  text-align: center;
}

.detail-label {
  color: var(--color-muted);
  font-size: 24rpx;
}

.detail-code {
  margin-top: 12rpx;
  color: var(--color-accent-strong);
  font-size: 82rpx;
  font-weight: 900;
  letter-spacing: 14rpx;
  text-indent: 14rpx;
}

.detail-primary {
  margin-top: 8rpx;
  color: var(--color-heading);
  font-size: 31rpx;
  font-weight: 700;
}

.detail-time {
  margin-top: 16rpx;
  color: var(--color-muted);
  font-size: 23rpx;
}

.top-row {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
  margin-top: 24rpx;
}

.top-chip {
  padding: 14rpx 20rpx;
  border-radius: 16rpx;
  font-size: 24rpx;
  font-weight: 700;
}

.full-result-button {
  margin-top: 30rpx;
}

.empty-title {
  color: var(--color-heading);
  font-size: 34rpx;
  font-weight: 700;
}

.empty-button {
  margin-top: 34rpx;
}
