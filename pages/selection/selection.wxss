.selection-page {
  padding-top: 24rpx;
  color: var(--color-heading);
}

.selection-intro {
  display: flex;
  align-items: flex-start;
  padding: 32rpx 30rpx;
  border: 1rpx solid var(--color-border);
  border-radius: 28rpx;
  background: linear-gradient(145deg, var(--color-surface), var(--color-accent-tint));
  box-shadow: 0 16rpx 38rpx rgba(var(--color-heading-rgb), 0.1);
}

.intro-seal {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: none;
  width: 68rpx;
  height: 68rpx;
  margin-right: 22rpx;
  border-radius: 18rpx;
  background: linear-gradient(145deg, var(--color-accent), var(--color-heading));
  color: var(--color-white);
  font-size: 34rpx;
  font-weight: 900;
  box-shadow: 0 8rpx 0 var(--color-heading);
}

.intro-copy {
  flex: 1;
  min-width: 0;
}

.intro-kicker {
  color: var(--color-accent-strong);
  font-size: 16rpx;
  font-weight: 800;
  letter-spacing: 2.5rpx;
}

.intro-title {
  margin-top: 10rpx;
  color: var(--color-heading);
  font-size: 36rpx;
  font-weight: 900;
}

.intro-description {
  margin-top: 14rpx;
  color: var(--color-muted);
  font-size: 23rpx;
  line-height: 1.65;
}

.chosen-version {
  display: flex;
  align-items: center;
  margin-top: 22rpx;
  padding: 20rpx 24rpx;
  border: 1rpx solid var(--color-border);
  border-radius: 22rpx;
  background: var(--color-surface);
  box-shadow: 0 8rpx 22rpx rgba(var(--color-heading-rgb), 0.07);
}

.chosen-professional {
  border-color: var(--color-accent-border);
  background: linear-gradient(145deg, var(--color-accent), var(--color-heading));
  color: var(--color-white);
}

.chosen-emblem {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: none;
  width: 52rpx;
  height: 52rpx;
  margin-right: 18rpx;
  border-radius: 15rpx;
  background: var(--color-accent-tint);
  color: var(--color-accent-strong);
  font-size: 25rpx;
  font-weight: 900;
}

.chosen-professional .chosen-emblem {
  background: rgba(255, 255, 255, 0.16);
  color: var(--color-on-dark);
}

.chosen-copy {
  flex: 1;
  min-width: 0;
}

.chosen-kicker {
  color: var(--color-muted);
  font-size: 18rpx;
}

.chosen-professional .chosen-kicker {
  color: rgba(255, 255, 255, 0.68);
}

.chosen-title {
  margin-top: 4rpx;
  color: var(--color-heading);
  font-size: 27rpx;
  font-weight: 800;
}

.chosen-professional .chosen-title {
  color: var(--color-white);
}

.chosen-status {
  flex: none;
  margin-left: 16rpx;
  color: var(--color-accent-strong);
  font-size: 19rpx;
  font-weight: 800;
}

.chosen-professional .chosen-status {
  color: var(--color-on-dark);
}

.selection-section {
  margin: 30rpx 4rpx 18rpx;
}

.section-title {
  color: var(--color-heading);
  font-size: 30rpx;
  font-weight: 800;
}

.section-description {
  margin-top: 5rpx;
  color: var(--color-muted);
  font-size: 21rpx;
}

.user-option-list {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 16rpx;
}

.user-option {
  display: flex;
  flex-direction: column;
  align-items: stretch;
  box-sizing: border-box;
  width: 100%;
  min-width: 0;
  min-height: 170rpx;
  margin: 0;
  padding: 18rpx 19rpx;
  border: 2rpx solid var(--color-border);
  border-radius: 22rpx;
  background: var(--color-surface);
  color: var(--color-heading);
  line-height: 1.3;
  text-align: left;
}

.user-option::after,
.continue-button::after {
  border: none;
}

.user-option.option-selected {
  border-color: var(--color-accent);
  background: var(--color-accent-soft);
  box-shadow: 0 5rpx 14rpx rgba(var(--color-heading-rgb), 0.1);
}

.option-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.option-emblem {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: none;
  width: 44rpx;
  height: 44rpx;
  border-radius: 12rpx;
  background: var(--color-accent-tint);
  color: var(--color-accent-strong);
  font-size: 23rpx;
  font-weight: 900;
}

.option-copy {
  min-width: 0;
}

.option-title {
  font-size: 26rpx;
  font-weight: 800;
}

.option-description {
  margin-top: 6rpx;
  color: var(--color-muted);
  font-size: 22rpx;
  line-height: 1.5;
}

.option-check {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: none;
  width: 31rpx;
  height: 31rpx;
  border-radius: 50%;
  background: var(--color-accent);
  color: var(--color-white);
  font-size: 19rpx;
  font-weight: 900;
}

.advisor-note {
  margin-bottom: 10rpx;
  color: var(--color-accent-strong);
  font-size: 23rpx;
  line-height: 1.6;
}

.legacy-draft-link {
  margin-top: 20rpx;
  padding: 16rpx;
  color: var(--color-accent-strong);
  font-size: 24rpx;
  text-align: center;
}

.version-heading {
  margin-top: 48rpx;
}

.version-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 16rpx;
}

.version-option {
  box-sizing: border-box;
  width: 100%;
  min-width: 0;
  min-height: 250rpx;
  margin: 0;
  padding: 20rpx;
  overflow: hidden;
  border-radius: 22rpx;
  line-height: 1.25;
  text-align: left;
}

.version-standard {
  border: 2rpx solid var(--color-border);
  background: linear-gradient(150deg, var(--color-surface), var(--color-accent-tint));
  color: var(--color-heading);
  box-shadow: 0 9rpx 0 var(--color-accent-border);
}

.version-professional {
  border: 2rpx solid var(--color-accent-border);
  background: linear-gradient(145deg, var(--color-accent), var(--color-heading));
  color: var(--color-white);
  box-shadow: 0 9rpx 0 var(--color-heading);
}

.version-selected {
  outline: 5rpx solid rgba(var(--color-accent-rgb), 0.18);
  outline-offset: -5rpx;
}

.version-professional.version-selected {
  outline-color: rgba(255, 255, 255, 0.36);
}

.version-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.version-emblem {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 40rpx;
  height: 40rpx;
  border-radius: 11rpx;
  background: var(--color-accent-tint);
  font-size: 21rpx;
  font-weight: 900;
}

.version-professional .version-emblem {
  background: rgba(255, 255, 255, 0.16);
  color: var(--color-on-dark);
}

.version-status {
  font-size: 18rpx;
  font-weight: 800;
}

.version-standard .version-status {
  color: var(--color-accent-strong);
}

.version-professional .version-status {
  color: var(--color-on-dark);
}

.version-title {
  margin-top: 18rpx;
  font-size: 29rpx;
  font-weight: 900;
}

.version-count {
  margin-top: 8rpx;
  font-size: 20rpx;
  font-weight: 800;
}

.version-count text {
  margin-right: 5rpx;
  font-size: 42rpx;
  line-height: 1;
}

.version-description {
  margin-top: 12rpx;
  color: var(--color-muted);
  font-size: 19rpx;
  line-height: 1.45;
}

.version-professional .version-description {
  color: rgba(255, 255, 255, 0.75);
}

.option-pressed {
  transform: translateY(5rpx);
}

.selection-footer {
  margin-top: 36rpx;
  padding: 28rpx;
  border-color: var(--color-border);
  background: var(--color-surface);
}

.selection-summary {
  color: var(--color-muted);
  font-size: 22rpx;
  line-height: 1.5;
  text-align: center;
}

.continue-button {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 92rpx;
  margin: 22rpx 0 0;
  border-radius: 20rpx;
  background: linear-gradient(145deg, var(--color-accent), var(--color-heading));
  color: var(--color-surface);
  font-size: 29rpx;
  font-weight: 800;
  box-shadow: 0 9rpx 0 var(--color-heading);
}

.continue-button[disabled] {
  background: var(--color-disabled);
  color: var(--color-disabled-text);
  box-shadow: 0 7rpx 0 var(--color-disabled);
}

.professional-action {
  background: linear-gradient(145deg, var(--color-accent), var(--color-heading));
  box-shadow: 0 9rpx 0 var(--color-heading);
}

.local-note {
  margin-top: 22rpx;
  color: var(--color-muted);
  font-size: 20rpx;
  line-height: 1.55;
  text-align: center;
}
