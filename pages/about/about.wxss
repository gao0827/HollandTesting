.about-page {
  padding-top: 24rpx;
}

.about-hero {
  padding: 46rpx 34rpx;
  border-radius: 32rpx;
  background: linear-gradient(145deg, var(--color-accent-soft), var(--color-accent-soft));
  text-align: center;
}

.about-mark {
  display: inline-flex;
  padding: 12rpx 24rpx;
  border-radius: 999rpx;
  background: var(--color-surface);
  color: var(--color-accent);
  font-size: 24rpx;
  font-weight: 800;
  letter-spacing: 4rpx;
}

.about-title {
  margin-top: 24rpx;
  color: var(--color-heading);
  font-size: 44rpx;
  font-weight: 800;
}

.about-subtitle {
  margin-top: 14rpx;
  color: var(--color-muted);
  font-size: 26rpx;
}

.about-card {
  margin-top: 24rpx;
  padding: 32rpx;
}

.about-section-title {
  color: var(--color-heading);
  font-size: 31rpx;
  font-weight: 700;
}

.about-copy {
  margin-top: 20rpx;
  color: var(--color-text);
  font-size: 26rpx;
  line-height: 1.8;
}

.step-item,
.privacy-row {
  display: flex;
  align-items: flex-start;
  margin-top: 22rpx;
  color: var(--color-text);
  font-size: 26rpx;
  line-height: 1.7;
}

.step-number,
.privacy-icon {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  flex: none;
  width: 38rpx;
  height: 38rpx;
  margin: 4rpx 18rpx 0 0;
  border-radius: 50%;
  background: var(--color-accent-soft);
  color: var(--color-accent-strong);
  font-size: 21rpx;
  font-weight: 800;
}

.privacy-icon {
  background: var(--color-success-soft);
  color: var(--color-success);
}

.notice-card {
  margin-top: 24rpx;
  padding: 28rpx 30rpx;
  border: 1rpx solid var(--color-warning-border);
  border-radius: 24rpx;
  background: var(--color-warning-soft);
}

.notice-title {
  color: var(--color-warning);
  font-size: 28rpx;
  font-weight: 700;
}

.notice-copy {
  margin-top: 14rpx;
  color: var(--color-warning);
  font-size: 24rpx;
  line-height: 1.75;
}

.about-button {
  margin-top: 30rpx;
}
