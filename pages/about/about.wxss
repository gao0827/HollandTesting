.about-page {
  padding-top: 24rpx;
}

.about-hero {
  padding: 46rpx 34rpx;
  border-radius: 32rpx;
  background: linear-gradient(145deg, #eef2ff, #f5f3ff);
  text-align: center;
}

.about-mark {
  display: inline-flex;
  padding: 12rpx 24rpx;
  border-radius: 999rpx;
  background: #ffffff;
  color: #4f46e5;
  font-size: 24rpx;
  font-weight: 800;
  letter-spacing: 4rpx;
}

.about-title {
  margin-top: 24rpx;
  color: #111827;
  font-size: 44rpx;
  font-weight: 800;
}

.about-subtitle {
  margin-top: 14rpx;
  color: #64748b;
  font-size: 26rpx;
}

.about-card {
  margin-top: 24rpx;
  padding: 32rpx;
}

.about-section-title {
  color: #111827;
  font-size: 31rpx;
  font-weight: 700;
}

.about-copy {
  margin-top: 20rpx;
  color: #475569;
  font-size: 26rpx;
  line-height: 1.8;
}

.step-item,
.privacy-row {
  display: flex;
  align-items: flex-start;
  margin-top: 22rpx;
  color: #475569;
  font-size: 26rpx;
  line-height: 1.7;
}

.step-number,
.privacy-icon {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  flex: none;
  width: 38rpx;
  height: 38rpx;
  margin: 4rpx 18rpx 0 0;
  border-radius: 50%;
  background: #eef2ff;
  color: #4338ca;
  font-size: 21rpx;
  font-weight: 800;
}

.privacy-icon {
  background: #d1fae5;
  color: #047857;
}

.notice-card {
  margin-top: 24rpx;
  padding: 28rpx 30rpx;
  border: 1rpx solid #fed7aa;
  border-radius: 24rpx;
  background: #fff7ed;
}

.notice-title {
  color: #9a3412;
  font-size: 28rpx;
  font-weight: 700;
}

.notice-copy {
  margin-top: 14rpx;
  color: #9a3412;
  font-size: 24rpx;
  line-height: 1.75;
}

.about-button {
  margin-top: 30rpx;
}
