@import "./knowledge-shared.wxss";
@import "../../components/interest-type-definition/interest-type-definition.wxss";

.knowledge-section {
  margin-top: 40rpx;
}

.type-filters {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin: 20rpx 0;
}

.type-filter {
  display: flex;
  align-items: center;
  min-height: 80rpx;
  margin: 0;
  padding: 0 22rpx;
  border: 1rpx solid var(--color-border);
  border-radius: 16rpx;
  background: var(--color-surface);
  color: var(--color-text-strong);
  font-size: 26rpx;
  line-height: 1.2;
}

.type-filter::after {
  border: none;
}

.type-filter-active {
  border-color: var(--color-accent-strong);
  background: var(--color-accent-strong);
  color: var(--color-white);
  font-weight: 600;
}

.type-explanation {
  padding: 22rpx 24rpx;
  border-left: 6rpx solid;
  border-radius: 12rpx;
  background: var(--color-accent-soft);
}

.knowledge-row {
  display: flex;
  align-items: center;
  gap: 18rpx;
  margin-top: 16rpx;
  padding: 24rpx;
}

.knowledge-row-pressed {
  background: var(--color-accent-soft);
}

.row-code {
  display: flex;
  flex: 0 0 54rpx;
  align-items: center;
  justify-content: center;
  height: 54rpx;
  border-radius: 14rpx;
  background: var(--color-accent-soft);
  color: var(--color-accent-strong);
  font-weight: 700;
}

.row-content {
  flex: 1;
  min-width: 0;
}

.row-arrow {
  color: var(--color-muted);
  font-size: 42rpx;
  line-height: 1;
}
