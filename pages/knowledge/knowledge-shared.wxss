.knowledge-hero {
  padding: 34rpx;
  border-radius: 28rpx;
  background: #262350;
  color: #ffffff;
}

.knowledge-title {
  font-size: 46rpx;
  font-weight: 700;
  line-height: 1.25;
}

.knowledge-summary {
  margin-top: 12rpx;
  color: #e0e7ff;
  font-size: 28rpx;
  line-height: 1.6;
}

.hero-category {
  margin-bottom: 12rpx;
  color: #c7d2fe;
  font-size: 26rpx;
}

.item-title {
  font-size: 30rpx;
  font-weight: 600;
  line-height: 1.4;
}

.item-description {
  margin-top: 8rpx;
  color: #475569;
  font-size: 27rpx;
  line-height: 1.6;
}

.detail-section {
  margin-top: 24rpx;
  padding: 28rpx;
}

.detail-line {
  display: flex;
  gap: 12rpx;
  margin-top: 14rpx;
  line-height: 1.6;
}

.detail-bullet {
  color: #4338ca;
}

.detail-action {
  margin-top: 18rpx;
  min-height: 84rpx;
  font-size: 27rpx;
}

.source-license {
  display: block;
  margin-top: 12rpx;
  color: #475569;
  font-size: 24rpx;
  overflow-wrap: break-word;
}
