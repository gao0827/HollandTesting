/* 方案一：东方书院。使用更高选择器权重覆盖旧版首页主题，不影响其他页面。 */
page {
  background: #f5efe6;
}

.home-page.academy-theme {
  padding-top: 20rpx;
  color: #27344a;
}

.academy-theme .top-bar {
  margin-bottom: 22rpx;
  padding: 0 6rpx;
}

.academy-theme .brand-mark {
  width: 64rpx;
  height: 64rpx;
  border: 2rpx solid rgba(255, 250, 239, 0.9);
  border-radius: 18rpx;
  background: linear-gradient(145deg, #294a7a, #18335a);
  color: #fff9ec;
  box-shadow: 0 9rpx 0 #cdb68e, 0 14rpx 24rpx rgba(59, 42, 27, 0.14);
}

.academy-theme .brand-name {
  color: #202b3d;
  font-family: "STSong", "SimSun", "PingFang SC", serif;
  font-size: 31rpx;
  font-weight: 800;
  letter-spacing: 2rpx;
}

.academy-theme .brand-caption {
  color: #8e765a;
  font-size: 14rpx;
  letter-spacing: 2.6rpx;
}

.academy-theme .hero-card {
  padding: 34rpx 32rpx 30rpx;
  border: 1rpx solid rgba(183, 143, 88, 0.34);
  border-radius: 34rpx;
  background:
    radial-gradient(circle at 14% 16%, rgba(177, 62, 46, 0.08) 0, rgba(177, 62, 46, 0) 32%),
    linear-gradient(145deg, #fffaf0 0%, #f8eddb 58%, #efe0c8 100%);
  color: #233451;
  box-shadow: 0 22rpx 52rpx rgba(83, 59, 33, 0.16);
}

.academy-theme .hero-card::before {
  top: auto;
  bottom: -190rpx;
  left: -100rpx;
  display: block;
  width: 430rpx;
  height: 300rpx;
  border: 2rpx solid rgba(43, 76, 118, 0.09);
  border-radius: 50% 50% 0 0;
  background: rgba(255, 255, 255, 0.08);
  transform: rotate(8deg);
}

.academy-theme .hero-card::after {
  right: -88rpx;
  top: -106rpx;
  display: block;
  width: 250rpx;
  height: 250rpx;
  border: 2rpx solid rgba(166, 55, 41, 0.12);
  background: transparent;
}

.academy-theme .hero-lattice {
  position: absolute;
  top: 0;
  right: 0;
  width: 128rpx;
  height: 128rpx;
  border-bottom: 2rpx solid rgba(135, 83, 47, 0.12);
  border-left: 2rpx solid rgba(135, 83, 47, 0.12);
  background-image:
    linear-gradient(rgba(135, 83, 47, 0.08) 2rpx, transparent 2rpx),
    linear-gradient(90deg, rgba(135, 83, 47, 0.08) 2rpx, transparent 2rpx);
  background-size: 30rpx 30rpx;
  opacity: 0.82;
}

.academy-theme .hero-main {
  min-height: 262rpx;
}

.academy-theme .hero-copy {
  padding-right: 16rpx;
}

.academy-theme .hero-illustration {
  width: 270rpx;
}

.academy-theme .hero-kicker {
  color: #a43d2e;
  font-family: "STKaiti", "KaiTi", "PingFang SC", serif;
  font-size: 21rpx;
  letter-spacing: 3rpx;
}

.academy-theme .hero-title {
  margin-top: 25rpx;
  color: #1f3152;
  font-family: "STSong", "SimSun", "PingFang SC", serif;
  font-size: 45rpx;
  font-weight: 900;
  letter-spacing: 1rpx;
  line-height: 1.25;
}

.academy-theme .hero-title-second {
  margin-top: 0;
}

.academy-theme .hero-subtitle {
  margin-top: 20rpx;
  color: #77664f;
  font-size: 23rpx;
  line-height: 1.68;
}

.academy-theme .assessment-entries {
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 16rpx;
  margin-top: 24rpx;
  padding-right: 2rpx;
  padding-left: 2rpx;
  padding-bottom: 12rpx;
}

.academy-theme .assessment-entry {
  box-sizing: border-box;
  width: 100%;
  min-width: 0;
  min-height: 176rpx;
  overflow: hidden;
  padding: 16rpx;
  border-radius: 20rpx;
}

.academy-theme .entry-head {
  min-width: 0;
}

.academy-theme .standard-entry {
  border: 2rpx solid #ead9bd;
  background: linear-gradient(155deg, #fffdf8, #f8eddc);
  color: #263b60;
  box-shadow: 0 10rpx 0 #d9c29d, 0 18rpx 30rpx rgba(75, 52, 29, 0.14);
}

.academy-theme .professional-entry {
  border: 2rpx solid #bd6b58;
  background: linear-gradient(145deg, #ac4938, #8f3329);
  color: #fff9ed;
  box-shadow: 0 10rpx 0 #68261f, 0 18rpx 30rpx rgba(95, 36, 28, 0.24);
}

.academy-theme .standard-entry.entry-pressed {
  box-shadow: 0 3rpx 0 #d9c29d, 0 8rpx 16rpx rgba(75, 52, 29, 0.13);
  transform: translateY(7rpx);
}

.academy-theme .professional-entry.entry-pressed {
  box-shadow: 0 3rpx 0 #68261f, 0 8rpx 16rpx rgba(95, 36, 28, 0.18);
  transform: translateY(7rpx);
}

.academy-theme .entry-title-row {
  display: flex;
  align-items: center;
  flex: 1;
  min-width: 0;
}

.academy-theme .entry-emblem {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: none;
  width: 38rpx;
  height: 38rpx;
  margin-right: 10rpx;
  border-radius: 11rpx;
  background: #e6d5b8;
  color: #29476f;
  font-family: "STKaiti", "KaiTi", serif;
  font-size: 20rpx;
  font-weight: 900;
}

.academy-theme .professional-emblem {
  background: rgba(255, 246, 224, 0.18);
  color: #ffe8b0;
}

.academy-theme .entry-title {
  color: inherit;
  font-family: "STSong", "SimSun", "PingFang SC", serif;
  font-size: 27rpx;
  letter-spacing: 1rpx;
}

.academy-theme .entry-state {
  flex: none;
  margin-left: 8rpx;
  color: #3e7659;
  font-size: 18rpx;
  white-space: nowrap;
}

.academy-theme .professional-state {
  color: #ffe3a3;
}

.academy-theme .entry-main {
  margin-top: 9rpx;
}

.academy-theme .entry-count {
  color: inherit;
}

.academy-theme .entry-count > text:first-child {
  font-size: 41rpx;
}

.academy-theme .entry-description {
  overflow: hidden;
  color: #76664e;
  font-size: 18rpx;
  text-overflow: ellipsis;
}

.academy-theme .professional-entry .entry-description {
  color: rgba(255, 249, 237, 0.75);
}

.academy-theme .entry-foot {
  margin-top: 10rpx;
}

.academy-theme .entry-availability {
  padding: 5rpx 9rpx;
  background: #e7efe8;
  color: #356a4d;
}

.academy-theme .professional-availability {
  background: rgba(255, 247, 226, 0.14);
  color: #ffe6ad;
}

.academy-theme .entry-arrow {
  color: #a43d2e;
}

.academy-theme .professional-arrow {
  color: #ffe6ad;
}

.academy-theme .draft-hint {
  margin-top: 17rpx;
  color: #7a6249;
}

.academy-theme .map-section {
  position: relative;
  overflow: hidden;
  border: 1rpx solid #e8dcc9;
  background:
    linear-gradient(150deg, rgba(255, 255, 255, 0.96), rgba(255, 251, 243, 0.96)),
    #fffaf0;
  box-shadow: 0 14rpx 38rpx rgba(74, 52, 31, 0.08);
}

.academy-theme .map-section::after {
  position: absolute;
  right: -82rpx;
  bottom: -104rpx;
  width: 240rpx;
  height: 170rpx;
  border: 2rpx solid rgba(40, 70, 108, 0.08);
  border-radius: 50% 50% 0 0;
  content: '';
  transform: rotate(-12deg);
}

.academy-theme .section-eyebrow {
  color: #a23d30;
  font-family: Georgia, "Times New Roman", serif;
  letter-spacing: 2.4rpx;
}

.academy-theme .section-title {
  color: #26344b;
  font-family: "STSong", "SimSun", "PingFang SC", serif;
  font-weight: 800;
}

.academy-theme .compass-chip {
  border: 1rpx solid #e2cfac;
  background: #fbf1dc;
  color: #8b5d32;
}

.academy-theme .map-description {
  color: #746955;
}

.academy-theme .section-caption {
  color: #9b876c;
}

.academy-theme .type-card {
  border-color: rgba(255, 250, 240, 0.92);
  box-shadow: 0 8rpx 22rpx rgba(66, 47, 29, 0.07);
}

.academy-theme .type-r { background: #e7eef5; color: #315b82; }
.academy-theme .type-i { background: #eee8f2; color: #6e4b7d; }
.academy-theme .type-a { background: #f5e7e5; color: #9a3f47; }
.academy-theme .type-s { background: #e5efe8; color: #3e7055; }
.academy-theme .type-e { background: #f5e9d9; color: #985b2e; }
.academy-theme .type-c { background: #ece8e0; color: #5b574f; }

.academy-theme .recent-card,
.academy-theme .button-ghost {
  border-color: #e3d7c5;
  background: #fffaf2;
}

.academy-theme .privacy-card {
  border-color: #cad9c9;
  background: #f1f5ec;
}

.academy-theme .privacy-title {
  color: #385a3d;
}

.academy-theme .privacy-copy {
  color: #647563;
}

.academy-theme .disclaimer {
  color: #9a8d7b;
}

@media (max-width: 360px) {
  .academy-theme .hero-main {
    display: flex;
  }

  .academy-theme .hero-copy {
    padding-right: 10rpx;
  }

  .academy-theme .hero-illustration {
    width: 238rpx;
    margin: 0;
  }

  .academy-theme .hero-title {
    font-size: 41rpx;
  }

  .academy-theme .assessment-entry {
    min-height: 176rpx;
    padding: 15rpx;
  }
}
