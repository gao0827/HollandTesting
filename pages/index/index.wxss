@import "./index-theme.wxss";
@import "../../components/interest-type-definition/interest-type-definition.wxss";

.home-page {
  padding-top: 24rpx;
}

.hero-card {
  position: relative;
  overflow: hidden;
  padding: 44rpx 40rpx 38rpx;
  border-radius: 36rpx;
  background: linear-gradient(145deg, var(--color-heading) 0%, var(--color-accent) 58%, var(--color-accent) 100%);
  color: var(--color-white);
  box-shadow: 0 24rpx 56rpx rgba(var(--color-heading-rgb), 0.24);
}

.hero-card::after {
  position: absolute;
  right: -70rpx;
  top: -80rpx;
  width: 280rpx;
  height: 280rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.14);
  border-radius: 50%;
  content: '';
}

.brand-row {
  display: flex;
  align-items: center;
}

.brand-mark {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 56rpx;
  height: 56rpx;
  margin-right: 16rpx;
  border-radius: 16rpx;
  background: rgba(255, 255, 255, 0.18);
  font-size: 28rpx;
  font-weight: 800;
}

.brand-name {
  font-size: 28rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
}

.hero-title {
  position: relative;
  z-index: 1;
  margin-top: 52rpx;
  font-size: 56rpx;
  font-weight: 800;
  line-height: 1.28;
}

.hero-title-second {
  margin-top: 0;
}

.hero-subtitle {
  position: relative;
  z-index: 1;
  margin-top: 24rpx;
  color: rgba(255, 255, 255, 0.78);
  font-size: 27rpx;
  line-height: 1.75;
}

.start-button {
  position: relative;
  z-index: 1;
  margin-top: 42rpx;
  background: var(--color-surface);
  color: var(--color-accent-strong);
}

.draft-hint {
  position: relative;
  z-index: 1;
  margin-top: 18rpx;
  color: rgba(255, 255, 255, 0.72);
  font-size: 24rpx;
  text-align: center;
}

.section-heading {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  margin: 52rpx 4rpx 24rpx;
}

.section-caption {
  color: var(--color-muted);
  font-size: 23rpx;
}

.recent-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 28rpx;
  padding: 30rpx 32rpx;
}

.recent-label {
  color: var(--color-muted);
  font-size: 23rpx;
}

.recent-title {
  margin-top: 8rpx;
  color: var(--color-heading);
  font-size: 32rpx;
  font-weight: 700;
}

.recent-time {
  margin-top: 8rpx;
  color: var(--color-muted);
  font-size: 23rpx;
}

.recent-arrow {
  color: var(--color-muted);
  font-size: 52rpx;
  font-weight: 300;
}

.home-knowledge {
  margin-top: 24rpx;
}

.home-actions {
  display: flex;
  gap: 20rpx;
  margin-top: 28rpx;
}

.half-button {
  flex: 1;
}

.disclaimer {
  margin: 36rpx 20rpx 0;
  color: var(--color-muted);
  font-size: 22rpx;
  line-height: 1.6;
  text-align: center;
}

/* M02 首页视觉升级 */
.home-page {
  padding-top: 20rpx;
}

.top-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
  padding: 0 4rpx;
}

.brand-row {
  display: flex;
  align-items: center;
}

.brand-mark {
  width: 64rpx;
  height: 64rpx;
  margin-right: 16rpx;
  border-radius: 20rpx;
  background: var(--color-accent);
  color: var(--color-white);
  font-size: 29rpx;
  font-weight: 900;
  box-shadow: 0 10rpx 24rpx rgba(var(--color-heading-rgb), 0.22);
}

.brand-name {
  color: var(--color-heading);
  font-size: 30rpx;
  font-weight: 800;
  letter-spacing: 0;
}

.brand-caption {
  margin-top: 2rpx;
  color: var(--color-muted);
  font-size: 15rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}

.version-badge {
  padding: 11rpx 18rpx;
  border: 1rpx solid var(--color-accent-border);
  border-radius: 999rpx;
  background: var(--color-accent-soft);
  color: var(--color-accent-strong);
  font-size: 21rpx;
  font-weight: 700;
}

.hero-card {
  padding: 36rpx 34rpx 30rpx;
  background: linear-gradient(145deg, var(--color-heading) 0%, var(--color-accent-strong) 48%, var(--color-accent) 100%);
}

.hero-card::after {
  display: none;
}

.hero-card::before {
  position: absolute;
  top: -120rpx;
  left: -100rpx;
  width: 300rpx;
  height: 300rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.08);
  border-radius: 50%;
  content: '';
}

.hero-main {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  min-height: 270rpx;
}

.hero-copy {
  flex: 1;
  min-width: 0;
  padding-right: 18rpx;
}

.hero-illustration {
  flex: none;
  width: 280rpx;
}

.hero-kicker {
  color: var(--color-on-dark-muted);
  font-size: 21rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}

.hero-title {
  margin-top: 26rpx;
  font-size: 46rpx;
  line-height: 1.24;
}

.hero-title-second {
  margin-top: 0;
}

.hero-subtitle {
  margin-top: 22rpx;
  font-size: 24rpx;
  line-height: 1.65;
}

.assessment-entries {
  position: relative;
  z-index: 1;
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20rpx;
  margin-top: 28rpx;
  padding-bottom: 14rpx;
}

.assessment-entry {
  display: block;
  box-sizing: border-box;
  min-height: 180rpx;
  margin: 0;
  padding: 18rpx 20rpx;
  border-radius: 22rpx;
  line-height: 1.2;
  text-align: left;
  transition: transform 0.12s ease, box-shadow 0.12s ease;
}

.assessment-entry::after {
  border: none;
}

.standard-entry {
  border: 2rpx solid rgba(255, 255, 255, 0.95);
  background: var(--color-surface);
  color: var(--color-heading);
  box-shadow: 0 12rpx 0 var(--color-accent-border), 0 22rpx 34rpx rgba(var(--color-heading-rgb), 0.2);
}

.professional-entry {
  border: 2rpx solid rgba(255, 255, 255, 0.95);
  background: var(--color-surface);
  color: var(--color-heading);
  box-shadow: 0 12rpx 0 var(--color-accent-border), 0 22rpx 34rpx rgba(var(--color-heading-rgb), 0.2);
}

.standard-entry.entry-pressed {
  box-shadow: 0 4rpx 0 var(--color-accent-border), 0 10rpx 18rpx rgba(var(--color-heading-rgb), 0.16);
  transform: translateY(8rpx);
}

.professional-entry.entry-pressed {
  box-shadow: 0 4rpx 0 var(--color-accent-border), 0 10rpx 18rpx rgba(var(--color-heading-rgb), 0.16);
  transform: translateY(8rpx);
}

.entry-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.entry-badge {
  padding: 7rpx 12rpx;
  border-radius: 999rpx;
  font-size: 16rpx;
  font-weight: 900;
  letter-spacing: 1rpx;
}

.standard-badge {
  background: var(--color-accent-soft);
  color: var(--color-accent);
}

.professional-badge {
  background: rgba(251, 191, 36, 0.2);
  color: var(--color-on-dark);
}

.entry-state {
  color: var(--color-success);
  font-size: 18rpx;
  font-weight: 700;
}

.professional-state {
  color: var(--color-accent);
}

.entry-title {
  margin-top: 0;
  font-size: 27rpx;
  font-weight: 800;
}

.entry-main {
  display: block;
  margin-top: 10rpx;
}

.entry-count {
  display: flex;
  align-items: baseline;
  margin-top: 0;
  font-size: 24rpx;
  font-weight: 800;
}

.entry-count > text:first-child {
  margin-right: 8rpx;
  font-size: 42rpx;
  font-weight: 900;
  line-height: 1;
}

.count-unit {
  margin-left: 4rpx;
  font-size: 21rpx;
  font-weight: 800;
}

.entry-availability {
  display: inline-flex;
  margin-top: 0;
  padding: 6rpx 10rpx;
  border-radius: 10rpx;
  background: var(--color-success-soft);
  color: var(--color-success);
  font-size: 18rpx;
  font-weight: 700;
}

.professional-availability {
  background: var(--color-accent-soft);
  color: var(--color-accent);
}

.entry-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 12rpx;
}

.entry-arrow {
  color: var(--color-accent);
  font-size: 25rpx;
  font-weight: 800;
}

.professional-arrow {
  color: var(--color-accent);
}

.version-note {
  position: relative;
  z-index: 1;
  margin-top: 18rpx;
  color: rgba(255, 255, 255, 0.58);
  font-size: 19rpx;
  line-height: 1.55;
  text-align: center;
}

.target-label {
  margin-left: 16rpx;
  padding: 7rpx 12rpx;
  border-radius: 999rpx;
  background: var(--color-accent-soft);
  color: var(--color-accent);
  font-size: 17rpx;
  font-weight: 700;
}

.professional-target {
  background: rgba(255, 255, 255, 0.12);
  color: rgba(255, 255, 255, 0.7);
}

.entry-reference {
  margin-top: 18rpx;
  color: var(--color-muted);
  font-size: 21rpx;
  line-height: 1.55;
}

.professional-reference {
  color: rgba(255, 255, 255, 0.64);
}

.current-version-note {
  margin-top: 16rpx;
  padding: 18rpx 20rpx;
  border-radius: 16rpx;
  background: var(--color-warning-soft);
  color: var(--color-warning);
  font-size: 20rpx;
  line-height: 1.6;
}

.entry-points {
  margin-top: 18rpx;
}

.entry-point {
  display: flex;
  align-items: flex-start;
  color: var(--color-text);
  font-size: 21rpx;
  line-height: 1.55;
}

.entry-point + .entry-point {
  margin-top: 7rpx;
}

.entry-point > text {
  flex: none;
  margin-right: 12rpx;
  color: var(--color-accent);
  font-size: 26rpx;
  line-height: 1.2;
}

.professional-points .entry-point {
  color: rgba(255, 255, 255, 0.72);
}

.professional-points .entry-point > text {
  color: var(--color-on-dark);
}

.entry-description {
  min-height: 0;
  margin: 3rpx 0 0;
  color: var(--color-muted);
  font-size: 18rpx;
  line-height: 1.55;
  text-align: left;
  white-space: nowrap;
}

.professional-entry .entry-description {
  color: var(--color-muted);
}

.entry-action {
  margin-top: 18rpx;
  color: var(--color-accent);
  font-size: 22rpx;
  font-weight: 800;
}

.professional-action {
  color: var(--color-on-dark);
}

.hero-facts {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  justify-content: space-around;
  margin-top: 28rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid rgba(255, 255, 255, 0.12);
}

.fact-item {
  display: flex;
  flex: 1;
  flex-direction: column;
  align-items: center;
}

.fact-value {
  font-size: 25rpx;
  font-weight: 800;
}

.fact-label {
  margin-top: 6rpx;
  color: rgba(255, 255, 255, 0.58);
  font-size: 19rpx;
}

.fact-divider {
  width: 1rpx;
  height: 42rpx;
  background: rgba(255, 255, 255, 0.14);
}

.map-section {
  margin-top: 30rpx;
  padding: 34rpx 26rpx 10rpx;
}

.section-heading {
  margin: 0;
}

.map-heading {
  padding: 0 8rpx;
}

.type-heading {
  margin: 46rpx 4rpx 22rpx;
}

.section-eyebrow {
  margin-bottom: 8rpx;
  color: var(--color-accent);
  font-size: 17rpx;
  font-weight: 800;
  letter-spacing: 2rpx;
}

.section-title {
  font-size: 33rpx;
}

.section-caption {
  font-size: 22rpx;
}

.compass-chip {
  padding: 10rpx 16rpx;
  border-radius: 999rpx;
  background: var(--color-accent-soft);
  color: var(--color-muted);
  font-size: 20rpx;
}

.map-description {
  margin: 18rpx 8rpx 0;
  color: var(--color-muted);
  font-size: 24rpx;
  line-height: 1.65;
}

.type-list {
  padding: 0 20rpx;
  border: 1rpx solid var(--color-border);
  border-radius: 24rpx;
  background: var(--color-surface);
}

.type-card {
  padding: 22rpx 0;
}

.type-card + .type-card {
  border-top: 1rpx solid var(--color-divider);
}

.recent-card {
  justify-content: flex-start;
  padding: 28rpx 30rpx;
}

.recent-content {
  flex: 1;
  min-width: 0;
}

.privacy-card {
  margin-top: 24rpx;
  padding: 24rpx 28rpx;
  border: 1rpx solid var(--color-accent-border);
  border-radius: 22rpx;
  background: var(--color-success-soft);
}

.privacy-title {
  color: var(--color-success);
  font-size: 25rpx;
  font-weight: 700;
}

.privacy-copy {
  margin-top: 5rpx;
  color: var(--color-success);
  font-size: 21rpx;
}

.disclaimer {
  margin: 30rpx 18rpx 0;
  font-size: 21rpx;
  line-height: 1.65;
}

@media (max-width: 360px) {
  .hero-main {
    display: block;
  }

  .hero-copy {
    padding-right: 0;
  }

  .hero-illustration {
    display: block;
    margin: 24rpx auto 0;
  }

  .assessment-entries {
    grid-template-columns: repeat(2, 1fr);
  }

  .assessment-entry {
    min-height: 180rpx;
  }
}
