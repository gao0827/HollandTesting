@import "../../components/type-representatives/type-representatives.wxss";
@import "../../components/interest-type-definition/interest-type-definition.wxss";

.result-page {
  padding-top: 24rpx;
}

.result-hero {
  padding: 54rpx 36rpx 46rpx;
  border-radius: 34rpx;
  background: var(--color-heading);
  color: var(--color-white);
  text-align: center;
  box-shadow: 0 12rpx 32rpx rgba(var(--color-heading-rgb), 0.12);
}

.result-kicker {
  color: var(--color-on-dark-muted);
  font-size: 25rpx;
  letter-spacing: 2rpx;
}

.result-code {
  margin-top: 18rpx;
  font-size: 104rpx;
  font-weight: 900;
  letter-spacing: 18rpx;
  line-height: 1.2;
  text-indent: 18rpx;
}

.result-primary {
  margin-top: 12rpx;
  font-size: 34rpx;
  font-weight: 700;
}

.result-tagline {
  margin-top: 12rpx;
  color: var(--color-on-dark);
  font-size: 26rpx;
}

.result-time {
  margin-top: 28rpx;
  color: var(--color-on-dark-muted);
  font-size: 22rpx;
}

.tie-note {
  margin-top: 20rpx;
  padding: 22rpx 26rpx;
  border-radius: 18rpx;
  background: var(--color-warning-soft);
  color: var(--color-warning);
  font-size: 23rpx;
  line-height: 1.65;
}

.section-block {
  margin-top: 46rpx;
}

.analysis-card {
  margin-top: 22rpx;
  padding: 30rpx;
  border-top-width: 6rpx;
}

.info-label {
  margin-top: 24rpx;
  color: var(--color-heading);
  font-size: 24rpx;
  font-weight: 700;
}

.info-text {
  margin-top: 8rpx;
  color: var(--color-muted);
  font-size: 24rpx;
  line-height: 1.65;
}

.advice-card {
  margin-top: 38rpx;
  padding: 32rpx;
}

.advice-title {
  margin-bottom: 22rpx;
  color: var(--color-heading);
  font-size: 31rpx;
  font-weight: 700;
}

.advice-item {
  display: flex;
  align-items: flex-start;
  color: var(--color-text);
  font-size: 25rpx;
  line-height: 1.6;
}

.advice-item + .advice-item {
  margin-top: 16rpx;
}

.advice-dot {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  flex: none;
  width: 34rpx;
  height: 34rpx;
  margin: 3rpx 16rpx 0 0;
  border-radius: 50%;
  background: var(--color-accent-soft);
  color: var(--color-accent-strong);
  font-size: 20rpx;
  font-weight: 700;
}

.combination-summary {
  margin: 12rpx 0 18rpx;
  color: var(--color-text-strong);
  font-size: 28rpx;
  line-height: 1.6;
}

.result-knowledge {
  min-height: 84rpx;
  margin-top: 20rpx;
  font-size: 27rpx;
}

.result-actions {
  margin-top: 34rpx;
}

.result-report {
  margin-top: 22rpx;
}

.secondary-actions {
  display: flex;
  gap: 20rpx;
  margin-top: 20rpx;
}

.secondary-button {
  flex: 1;
}

.result-disclaimer {
  margin: 34rpx 20rpx 0;
  color: var(--color-muted);
  font-size: 22rpx;
  line-height: 1.6;
  text-align: center;
}

.empty-title {
  color: var(--color-heading);
  font-size: 34rpx;
  font-weight: 700;
}

.empty-copy {
  margin-top: 16rpx;
  color: var(--color-muted);
  font-size: 26rpx;
}

.empty-button {
  margin-top: 34rpx;
}
.result-choice {
  margin-bottom: 22rpx;
  padding: 28rpx;
}

.result-hero + .result-choice {
  margin-top: 22rpx;
}

.result-choice-copy {
  margin-top: 10rpx;
  color: var(--color-text);
  font-size: 26rpx;
  line-height: 1.6;
}
