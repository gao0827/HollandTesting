@import "../../components/type-representatives/type-representatives.wxss";

.result-page {
  padding-top: 24rpx;
}

.result-hero {
  padding: 54rpx 36rpx 46rpx;
  border-radius: 34rpx;
  background: linear-gradient(145deg, #312e81, #4f46e5 58%, #7c3aed);
  color: #ffffff;
  text-align: center;
  box-shadow: 0 24rpx 56rpx rgba(79, 70, 229, 0.24);
}

.result-kicker {
  color: rgba(255, 255, 255, 0.72);
  font-size: 25rpx;
  letter-spacing: 2rpx;
}

.result-code {
  margin-top: 18rpx;
  font-size: 104rpx;
  font-weight: 900;
  letter-spacing: 18rpx;
  line-height: 1.2;
  text-indent: 18rpx;
}

.result-primary {
  margin-top: 12rpx;
  font-size: 34rpx;
  font-weight: 700;
}

.result-tagline {
  margin-top: 12rpx;
  color: rgba(255, 255, 255, 0.8);
  font-size: 26rpx;
}

.result-time {
  margin-top: 28rpx;
  color: rgba(255, 255, 255, 0.55);
  font-size: 22rpx;
}

.tie-note {
  margin-top: 20rpx;
  padding: 22rpx 26rpx;
  border-radius: 18rpx;
  background: #fff7ed;
  color: #9a3412;
  font-size: 23rpx;
  line-height: 1.65;
}

.section-block {
  margin-top: 46rpx;
}

.analysis-card {
  margin-top: 22rpx;
  padding: 30rpx;
  border-top-width: 6rpx;
}

.analysis-head {
  display: flex;
  align-items: center;
}

.analysis-rank {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 62rpx;
  height: 62rpx;
  margin-right: 20rpx;
  border-radius: 18rpx;
  font-size: 28rpx;
  font-weight: 800;
}

.analysis-heading {
  flex: 1;
}

.analysis-title {
  color: #111827;
  font-size: 31rpx;
  font-weight: 700;
}

.analysis-tagline {
  margin-top: 5rpx;
  color: #64748b;
  font-size: 23rpx;
}

.analysis-description {
  margin-top: 24rpx;
  color: #475569;
  font-size: 26rpx;
  line-height: 1.75;
}

.info-label {
  margin-top: 24rpx;
  color: #111827;
  font-size: 24rpx;
  font-weight: 700;
}

.info-text {
  margin-top: 8rpx;
  color: #64748b;
  font-size: 24rpx;
  line-height: 1.65;
}

.advice-card {
  margin-top: 38rpx;
  padding: 32rpx;
}

.advice-title {
  margin-bottom: 22rpx;
  color: #111827;
  font-size: 31rpx;
  font-weight: 700;
}

.advice-item {
  display: flex;
  align-items: flex-start;
  color: #475569;
  font-size: 25rpx;
  line-height: 1.6;
}

.advice-item + .advice-item {
  margin-top: 16rpx;
}

.advice-dot {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  flex: none;
  width: 34rpx;
  height: 34rpx;
  margin: 3rpx 16rpx 0 0;
  border-radius: 50%;
  background: #eef2ff;
  color: #4338ca;
  font-size: 20rpx;
  font-weight: 700;
}

.combination-summary {
  margin: 12rpx 0 18rpx;
  color: #334155;
  font-size: 28rpx;
  line-height: 1.6;
}

.result-knowledge {
  min-height: 84rpx;
  margin-top: 20rpx;
  font-size: 27rpx;
}

.result-actions {
  margin-top: 34rpx;
}

.result-report {
  margin-top: 22rpx;
}

.secondary-actions {
  display: flex;
  gap: 20rpx;
  margin-top: 20rpx;
}

.secondary-button {
  flex: 1;
}

.result-disclaimer {
  margin: 34rpx 20rpx 0;
  color: #94a3b8;
  font-size: 22rpx;
  line-height: 1.6;
  text-align: center;
}

.empty-title {
  color: #111827;
  font-size: 34rpx;
  font-weight: 700;
}

.empty-copy {
  margin-top: 16rpx;
  color: #64748b;
  font-size: 26rpx;
}

.empty-button {
  margin-top: 34rpx;
}
