.career-scene {
  position: relative;
  box-sizing: border-box;
  width: 100%;
  height: 244rpx;
  overflow: hidden;
  border: 1rpx solid var(--color-accent-border);
  border-radius: 28rpx;
  background: var(--color-accent-soft);
}

.career-scene-image {
  display: block;
  width: 100%;
  height: 100%;
  filter: saturate(0.78);
}

.career-scene::after {
  position: absolute;
  inset: 0;
  background: rgba(var(--color-accent-rgb), 0.12);
  content: '';
  pointer-events: none;
}
