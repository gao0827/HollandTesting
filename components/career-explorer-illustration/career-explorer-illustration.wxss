.career-scene {
  position: relative;
  box-sizing: border-box;
  width: 280rpx;
  height: 248rpx;
  overflow: hidden;
  border: 1rpx solid rgba(255, 255, 255, 0.14);
  border-radius: 30rpx;
  background: linear-gradient(180deg, rgba(255, 255, 255, 0.12), rgba(255, 255, 255, 0.04));
}

.scene-sun {
  position: absolute;
  top: 26rpx;
  right: 32rpx;
  width: 42rpx;
  height: 42rpx;
  border-radius: 50%;
  background: #fbbf24;
  box-shadow: 0 0 0 12rpx rgba(251, 191, 36, 0.12);
}

.scene-cloud {
  position: absolute;
  height: 12rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.45);
}

.cloud-one { top: 54rpx; left: 24rpx; width: 56rpx; }
.cloud-two { top: 82rpx; left: 62rpx; width: 34rpx; opacity: 0.55; }

.scene-hill {
  position: absolute;
  border-radius: 50% 50% 0 0;
}

.hill-back {
  right: -40rpx;
  bottom: -30rpx;
  width: 250rpx;
  height: 126rpx;
  background: rgba(167, 243, 208, 0.35);
  transform: rotate(-6deg);
}

.hill-front {
  bottom: -40rpx;
  left: -56rpx;
  width: 260rpx;
  height: 132rpx;
  background: rgba(196, 181, 253, 0.4);
  transform: rotate(7deg);
}

.scene-path {
  position: absolute;
  right: 0;
  bottom: -46rpx;
  width: 170rpx;
  height: 126rpx;
  border: 7rpx solid rgba(255, 255, 255, 0.55);
  border-top-color: transparent;
  border-left-color: transparent;
  border-radius: 50%;
  transform: rotate(-22deg);
}

.culture-book {
  position: absolute;
  z-index: 2;
  top: 24rpx;
  left: 108rpx;
  width: 62rpx;
  height: 42rpx;
  transform: rotate(-6deg);
}

.book-page {
  position: absolute;
  top: 0;
  box-sizing: border-box;
  width: 32rpx;
  height: 40rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.85);
  background: rgba(255, 255, 255, 0.2);
}

.book-left {
  left: 0;
  border-radius: 8rpx 2rpx 2rpx 8rpx;
  transform: skewY(7deg);
}

.book-right {
  right: 0;
  border-radius: 2rpx 8rpx 8rpx 2rpx;
  transform: skewY(-7deg);
}

.book-spine {
  position: absolute;
  top: 2rpx;
  left: 30rpx;
  width: 2rpx;
  height: 38rpx;
  background: rgba(255, 255, 255, 0.8);
}

.culture-briefcase {
  position: absolute;
  z-index: 2;
  bottom: 18rpx;
  left: 16rpx;
  box-sizing: border-box;
  width: 50rpx;
  height: 38rpx;
  border: 3rpx solid rgba(255, 255, 255, 0.78);
  border-radius: 9rpx;
  background: rgba(49, 46, 129, 0.45);
}

.briefcase-handle {
  position: absolute;
  top: -13rpx;
  left: 13rpx;
  box-sizing: border-box;
  width: 20rpx;
  height: 13rpx;
  border: 3rpx solid rgba(255, 255, 255, 0.78);
  border-bottom: 0;
  border-radius: 8rpx 8rpx 0 0;
}

.briefcase-lock {
  position: absolute;
  top: 14rpx;
  left: 20rpx;
  width: 8rpx;
  height: 8rpx;
  border-radius: 2rpx;
  background: #fde68a;
}

.culture-spark {
  position: absolute;
  z-index: 3;
  color: #fde68a;
  font-weight: 900;
}

.spark-one {
  top: 18rpx;
  left: 70rpx;
  font-size: 20rpx;
}

.spark-two {
  top: 98rpx;
  right: 18rpx;
  color: #bfdbfe;
  font-size: 16rpx;
}

.sign-post {
  position: absolute;
  top: 70rpx;
  right: 34rpx;
  width: 92rpx;
  height: 138rpx;
}

.sign-pole {
  position: absolute;
  top: 18rpx;
  left: 43rpx;
  width: 8rpx;
  height: 120rpx;
  border-radius: 999rpx;
  background: #f8fafc;
}

.sign-board {
  position: absolute;
  z-index: 1;
  box-sizing: border-box;
  height: 34rpx;
  padding: 0 12rpx;
  border-radius: 9rpx;
  color: #312e81;
  font-size: 17rpx;
  font-weight: 700;
  line-height: 34rpx;
  white-space: nowrap;
}

.sign-learning { top: 0; left: 10rpx; background: #fde68a; }
.sign-practice { top: 40rpx; left: 36rpx; background: #bfdbfe; }
.sign-growth { top: 80rpx; left: 4rpx; background: #a7f3d0; }

.explorer {
  position: absolute;
  bottom: 30rpx;
  left: 56rpx;
  width: 96rpx;
  height: 150rpx;
}

.explorer-head {
  position: absolute;
  top: 8rpx;
  left: 35rpx;
  width: 44rpx;
  height: 48rpx;
  border-radius: 48% 48% 45% 45%;
  background: #f4c7a1;
}

.explorer-hair {
  position: absolute;
  z-index: 1;
  top: 2rpx;
  left: 31rpx;
  width: 50rpx;
  height: 28rpx;
  border-radius: 30rpx 30rpx 12rpx 12rpx;
  background: #1e293b;
  transform: rotate(-5deg);
}

.explorer-body {
  position: absolute;
  top: 52rpx;
  left: 24rpx;
  width: 64rpx;
  height: 70rpx;
  border-radius: 24rpx 24rpx 16rpx 16rpx;
  background: #f8fafc;
  transform: rotate(5deg);
}

.explorer-arm {
  position: absolute;
  z-index: 2;
  top: 64rpx;
  left: 66rpx;
  width: 48rpx;
  height: 14rpx;
  border-radius: 999rpx;
  background: #f4c7a1;
  transform: rotate(-25deg);
  transform-origin: left;
}

.explorer-leg {
  position: absolute;
  top: 112rpx;
  width: 18rpx;
  height: 48rpx;
  border-radius: 999rpx;
  background: #312e81;
  transform-origin: top;
}

.leg-left { left: 37rpx; transform: rotate(12deg); }
.leg-right { left: 68rpx; transform: rotate(-14deg); }

.explorer-bag {
  position: absolute;
  top: 62rpx;
  left: 14rpx;
  width: 32rpx;
  height: 50rpx;
  border: 4rpx solid #f59e0b;
  border-radius: 12rpx;
  background: #fbbf24;
  transform: rotate(-7deg);
}

.mini-compass {
  position: absolute;
  right: 22rpx;
  bottom: 16rpx;
  width: 48rpx;
  height: 48rpx;
  border: 4rpx solid rgba(255, 255, 255, 0.82);
  border-radius: 50%;
  background: rgba(49, 46, 129, 0.65);
}

.mini-needle {
  position: absolute;
  top: 6rpx;
  left: 50%;
  width: 0;
  height: 0;
  border-right: 6rpx solid transparent;
  border-bottom: 30rpx solid #fb7185;
  border-left: 6rpx solid transparent;
  transform: translateX(-50%) rotate(25deg);
  transform-origin: center bottom;
}

.mini-center {
  position: absolute;
  top: 50%;
  left: 50%;
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: #ffffff;
  transform: translate(-50%, -50%);
}

/* 东方书院主题：全部图形使用 WXML/WXSS 绘制，不依赖外部图片。 */
.academy-scene {
  width: 270rpx;
  height: 244rpx;
  border: 1rpx solid rgba(122, 82, 45, 0.2);
  border-radius: 28rpx;
  background:
    radial-gradient(circle at 75% 20%, rgba(180, 64, 44, 0.09), transparent 30%),
    linear-gradient(180deg, rgba(255, 253, 246, 0.96), rgba(237, 221, 194, 0.78));
  box-shadow: inset 0 0 0 8rpx rgba(255, 255, 255, 0.24);
}

.window-lattice {
  position: absolute;
  z-index: 1;
  top: 0;
  right: 0;
  width: 82rpx;
  height: 82rpx;
  border-bottom: 2rpx solid rgba(128, 72, 39, 0.2);
  border-left: 2rpx solid rgba(128, 72, 39, 0.2);
  background-image:
    linear-gradient(rgba(128, 72, 39, 0.16) 2rpx, transparent 2rpx),
    linear-gradient(90deg, rgba(128, 72, 39, 0.16) 2rpx, transparent 2rpx);
  background-size: 22rpx 22rpx;
  opacity: 0.7;
}

.academy-scene .scene-sun {
  z-index: 2;
  top: 28rpx;
  right: 29rpx;
  width: 36rpx;
  height: 36rpx;
  background: #b84432;
  box-shadow: 0 0 0 10rpx rgba(184, 68, 50, 0.08);
}

.academy-mountain {
  position: absolute;
  bottom: 0;
  clip-path: polygon(50% 0, 100% 100%, 0 100%);
}

.mountain-back {
  right: -22rpx;
  bottom: 34rpx;
  width: 186rpx;
  height: 130rpx;
  background: #c9d2cc;
  opacity: 0.58;
}

.mountain-middle {
  right: 42rpx;
  bottom: 10rpx;
  width: 190rpx;
  height: 128rpx;
  background: #9eafa7;
  opacity: 0.62;
}

.mountain-front {
  left: -46rpx;
  width: 216rpx;
  height: 116rpx;
  background: #718b81;
  opacity: 0.52;
}

.mountain-path {
  position: absolute;
  z-index: 2;
  right: 38rpx;
  bottom: -30rpx;
  width: 138rpx;
  height: 102rpx;
  border: 7rpx solid rgba(255, 249, 232, 0.86);
  border-top-color: transparent;
  border-left-color: transparent;
  border-radius: 50%;
  transform: rotate(-26deg);
}

.academy-pavilion {
  position: absolute;
  z-index: 3;
  right: 76rpx;
  bottom: 54rpx;
  width: 66rpx;
  height: 62rpx;
}

.pavilion-roof {
  position: absolute;
  top: 0;
  left: 0;
  width: 66rpx;
  height: 22rpx;
  clip-path: polygon(10% 44%, 50% 0, 90% 44%, 100% 64%, 58% 54%, 50% 76%, 42% 54%, 0 64%);
  background: #7f342a;
}

.pavilion-beam {
  position: absolute;
  top: 19rpx;
  left: 11rpx;
  width: 44rpx;
  height: 7rpx;
  border-radius: 2rpx;
  background: #8e4d31;
}

.pavilion-column {
  position: absolute;
  top: 25rpx;
  width: 6rpx;
  height: 37rpx;
  border-radius: 1rpx;
  background: #8e4d31;
}

.column-left { left: 18rpx; }
.column-right { right: 18rpx; }

.culture-scroll {
  position: absolute;
  z-index: 5;
  left: 15rpx;
  bottom: 14rpx;
  width: 76rpx;
  height: 48rpx;
  transform: rotate(-7deg);
}

.scroll-paper {
  position: absolute;
  top: 5rpx;
  left: 7rpx;
  width: 62rpx;
  height: 38rpx;
  border: 2rpx solid #d8bd8b;
  border-radius: 4rpx;
  background: #fff8e8;
  box-shadow: 0 5rpx 10rpx rgba(77, 50, 27, 0.12);
}

.scroll-axis {
  position: absolute;
  top: 0;
  width: 7rpx;
  height: 48rpx;
  border-radius: 999rpx;
  background: #8a4a2e;
}

.axis-left { left: 2rpx; }
.axis-right { right: 2rpx; }

.scroll-mark {
  position: absolute;
  z-index: 1;
  top: 10rpx;
  left: 29rpx;
  color: #a33d30;
  font-family: "STKaiti", "KaiTi", serif;
  font-size: 22rpx;
  font-weight: 900;
}

.academy-scene .culture-book {
  z-index: 6;
  top: auto;
  bottom: 24rpx;
  left: 94rpx;
  width: 70rpx;
  height: 44rpx;
  transform: rotate(2deg);
}

.academy-scene .book-page {
  width: 36rpx;
  height: 43rpx;
  border-color: #d6b77e;
  background: #fffaf0;
  box-shadow: 0 5rpx 12rpx rgba(74, 50, 28, 0.12);
}

.academy-scene .book-spine {
  left: 34rpx;
  height: 40rpx;
  background: #b68c54;
}

.academy-scene .culture-spark {
  color: #bd7d32;
}

.academy-scene .spark-one {
  top: 24rpx;
  left: 34rpx;
}

.academy-scene .spark-two {
  top: 80rpx;
  right: 20rpx;
  color: #a33d30;
}

.academy-scene .mini-compass {
  z-index: 6;
  right: 16rpx;
  bottom: 14rpx;
  width: 50rpx;
  height: 50rpx;
  border-color: #fff8e8;
  background: #294a74;
  box-shadow: 0 8rpx 16rpx rgba(34, 55, 82, 0.2);
}

.academy-scene .mini-needle {
  border-bottom-color: #c14c39;
}
