.chart {
  padding: 30rpx;
  border: 1rpx solid var(--color-border);
  border-radius: 28rpx;
  background: var(--color-surface);
  color: var(--color-heading);
  box-shadow: 0 12rpx 32rpx rgba(var(--color-heading-rgb), 0.06);
}

.chart-title {
  font-size: 36rpx;
  font-weight: 700;
}

.chart-intro,
.chart-note,
.chart-footnote {
  color: var(--color-text);
  font-size: 26rpx;
  line-height: 1.55;
}

.chart-intro {
  margin-top: 10rpx;
}

.compass {
  width: 100%;
  max-width: 500rpx;
  margin: 14rpx auto 0;
}

.compass-plot {
  position: relative;
  padding-bottom: 100%;
}

.compass-grid-line,
.compass-outline {
  position: absolute;
  height: 2rpx;
  transform-origin: left center;
  background: #ded7e7;
}

.compass-shape {
  position: absolute;
  inset: 0;
  background: rgba(var(--color-accent-rgb), 0.22);
}

.compass-outline {
  height: 4rpx;
  border-radius: 4rpx;
  background: var(--color-accent);
}

.compass-point,
.compass-axis {
  position: absolute;
  transform: translate(-50%, -50%);
}

.compass-point {
  box-sizing: border-box;
  width: 17rpx;
  height: 17rpx;
  border: 2rpx solid var(--color-surface);
  border-radius: 50%;
}

.compass-axis {
  font-size: 30rpx;
  font-weight: 800;
}

.chart-row {
  margin-top: 20rpx;
}

.chart-row-label {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  align-items: center;
  font-size: 26rpx;
  font-weight: 600;
}

.chart-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
}

.chart-dimension {
  flex: 1;
}

.chart-value {
  color: var(--color-text-strong);
  font-variant-numeric: tabular-nums;
}

.chart-note {
  margin-top: 26rpx;
  padding: 18rpx 20rpx;
  border-radius: 16rpx;
  background: var(--color-accent-soft);
}

.chart-note-title {
  margin-bottom: 5rpx;
  color: var(--color-heading);
  font-weight: 700;
}

.chart-footnote {
  margin-top: 8rpx;
}
