.holland-visual {
  position: relative;
  box-sizing: border-box;
  width: 100%;
  height: 540rpx;
  overflow: hidden;
}

.visual-halo {
  position: absolute;
  box-sizing: border-box;
  border-radius: 50%;
}

.halo-one {
  top: 74rpx;
  left: 50%;
  width: 390rpx;
  height: 390rpx;
  border: 1rpx solid var(--color-accent-border);
  background: radial-gradient(circle at 42% 34%, var(--color-surface) 5%, var(--color-accent-soft) 55%, var(--color-accent-tint) 100%);
  box-shadow: inset 0 2rpx 0 rgba(255, 255, 255, 0.9), 0 8rpx 22rpx rgba(var(--color-heading-rgb), 0.08);
  transform: translateX(-50%);
}

.halo-two {
  top: 122rpx;
  left: 50%;
  width: 298rpx;
  height: 298rpx;
  border: 2rpx dashed rgba(var(--color-accent-rgb), 0.32);
  transform: translateX(-50%);
}

.connector {
  position: absolute;
  top: 268rpx;
  left: 50%;
  width: 344rpx;
  height: 2rpx;
  background: linear-gradient(90deg, transparent, rgba(var(--color-accent-rgb), 0.34) 32%, rgba(var(--color-accent-rgb), 0.34) 68%, transparent);
  transform-origin: center;
}

.connector-vertical { transform: translateX(-50%) rotate(90deg); }
.connector-left { transform: translateX(-50%) rotate(30deg); }
.connector-right { transform: translateX(-50%) rotate(-30deg); }

.hexagon {
  position: absolute;
  top: 146rpx;
  left: 50%;
  width: 260rpx;
  height: 248rpx;
  filter: drop-shadow(0 9rpx 12rpx rgba(var(--color-accent-rgb), 0.22));
  transform: translateX(-50%);
}

.hexagon-base,
.hexagon-outer,
.hexagon-inner {
  clip-path: polygon(25% 0, 75% 0, 100% 50%, 75% 100%, 25% 100%, 0 50%);
}

.hexagon-base,
.hexagon-outer {
  position: absolute;
  inset: 0;
}

.hexagon-base {
  background: linear-gradient(135deg, var(--color-accent), var(--color-accent-strong));
  transform: translateY(7rpx);
}

.hexagon-outer {
  padding: 4rpx;
  background: linear-gradient(145deg, var(--color-accent-border), var(--color-accent));
}

.hexagon-inner {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  width: 100%;
  height: 100%;
  background: linear-gradient(150deg, var(--color-surface) 8%, var(--color-accent-soft) 52%, var(--color-accent-tint) 100%);
}

.compass-ring {
  position: relative;
  box-sizing: border-box;
  width: 66rpx;
  height: 66rpx;
  border: 3rpx solid var(--color-accent);
  border-radius: 50%;
  background: linear-gradient(150deg, var(--color-white) 35%, var(--color-accent-soft));
  box-shadow: 0 4rpx 8rpx rgba(var(--color-accent-rgb), 0.17), inset 0 2rpx 2rpx var(--color-white);
}

.compass-needle {
  position: absolute;
  left: 50%;
  width: 0;
  height: 0;
  transform: translateX(-50%);
}

.needle-top {
  top: 7rpx;
  border-right: 8rpx solid transparent;
  border-bottom: 24rpx solid var(--color-accent);
  border-left: 8rpx solid transparent;
}

.needle-bottom {
  bottom: 7rpx;
  border-top: 24rpx solid var(--color-heading);
  border-right: 8rpx solid transparent;
  border-left: 8rpx solid transparent;
}

.compass-center {
  position: absolute;
  top: 50%;
  left: 50%;
  width: 10rpx;
  height: 10rpx;
  border: 3rpx solid var(--color-white);
  border-radius: 50%;
  background: var(--color-heading);
  transform: translate(-50%, -50%);
}

.hexagon-title {
  margin-top: 12rpx;
  color: var(--color-heading);
  font-size: 27rpx;
  font-weight: 900;
  letter-spacing: 4rpx;
  text-indent: 4rpx;
}

.hexagon-subtitle {
  margin-top: 3rpx;
  color: var(--color-accent-strong);
  font-size: 19rpx;
}

.type-node {
  position: absolute;
  z-index: 2;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  width: 108rpx;
  height: 108rpx;
  border: 2rpx solid;
  border-radius: 30rpx;
  color: var(--color-heading);
  box-shadow: 0 3rpx 0 rgba(var(--color-heading-rgb), 0.12), 0 8rpx 16rpx rgba(var(--color-heading-rgb), 0.12), inset 0 2rpx 0 rgba(255, 255, 255, 0.9);
}

.type-code {
  font-size: 29rpx;
  font-weight: 900;
  line-height: 1;
}

.type-name {
  margin-top: 8rpx;
  font-size: 19rpx;
  font-weight: 600;
}

.node-r {
  top: 18rpx;
  left: 50%;
  border-color: #bdd6e3;
  background: linear-gradient(145deg, #f2f8fc, #d4e7f2);
  transform: translateX(-50%);
}

.node-i {
  top: 126rpx;
  right: 34rpx;
  border-color: #d4c8e5;
  background: linear-gradient(145deg, #f8f4fc, #e7dcf3);
}

.node-a {
  right: 34rpx;
  bottom: 78rpx;
  border-color: #e3c4cf;
  background: linear-gradient(145deg, #fdf4f6, #f2dce5);
}

.node-s {
  bottom: 12rpx;
  left: 50%;
  border-color: #b7d8c6;
  background: linear-gradient(145deg, #f0f9f3, #d0e9dc);
  transform: translateX(-50%);
}

.node-e {
  bottom: 78rpx;
  left: 34rpx;
  border-color: #e4ceaf;
  background: linear-gradient(145deg, #fcf7ee, #f2e2c9);
}

.node-c {
  top: 126rpx;
  left: 34rpx;
  border-color: #c9d6d8;
  background: linear-gradient(145deg, #f5f8f9, #e0e8ec);
}
