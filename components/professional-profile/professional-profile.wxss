.professional-profile {
  margin-top: 34rpx;
}

.professional-section {
  margin-top: 18rpx;
  padding: 26rpx;
}

.professional-heading,
.professional-score-label {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 12rpx;
}

.professional-heading {
  color: var(--color-heading);
  font-size: 32rpx;
  font-weight: 700;
}

.professional-scale,
.professional-coverage {
  color: var(--color-muted);
  font-size: 24rpx;
  font-weight: 400;
}

.professional-copy,
.professional-interpretation {
  margin-top: 10rpx;
  color: var(--color-text);
  font-size: 26rpx;
  line-height: 1.6;
}

.professional-check {
  margin-top: 16rpx;
  padding-top: 14rpx;
  border-top: 1rpx solid var(--color-divider);
}

.professional-check-title {
  color: var(--color-accent-strong);
  font-size: 25rpx;
  font-weight: 700;
}

.professional-score {
  margin-top: 17rpx;
  color: var(--color-text-strong);
  font-size: 26rpx;
}

.professional-track {
  height: 10rpx;
  margin: 8rpx 0 0;
  overflow: hidden;
  border-radius: 999rpx;
  background: var(--color-divider);
}

.professional-fill {
  height: 100%;
  border-radius: inherit;
  background: var(--color-accent);
}

.professional-coverage {
  margin-top: 5rpx;
}

.professional-interpretation {
  margin-top: 18rpx;
  padding: 12rpx 16rpx;
  border-radius: 12rpx;
  background: var(--color-accent-soft);
}
